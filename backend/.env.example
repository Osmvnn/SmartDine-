PORT=5000
# Supabase PostgreSQL is the active backend. Keep DATABASE_URL server-side only.
DB_PROVIDER=postgres
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_SSL=true
# For Supabase, set DB_SSL=true. To verify the server certificate too,
# download the project CA certificate and set DB_SSL_CA_FILE to its local path.
DB_SSL_CA_FILE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_restaurant
JWT_SECRET=replace_with_a_long_random_secret_string
ALLOWED_ORIGINS=http://localhost:5173
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Online payment simulation is opt-in and only works with NODE_ENV=development.
# Keep disabled for real restaurant use. No payment provider is integrated yet.
ALLOW_DEMO_PAYMENTS=false
